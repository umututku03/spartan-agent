# Copy to .env. Only fill the API keys you use. .env is ignored by Git.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-6-luna
OPENAI_API_KEY=
MAX_PILOT_USD=0.10
MAX_API_REQUESTS=12
MAX_OUTPUT_TOKENS=256
OPENAI_REASONING_EFFORT=none

# Optional Claude comparison. Only ANTHROPIC_API_KEY must be added to your .env.
# The runner already defaults to the model and URL below.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
ANTHROPIC_BASE_URL=https://api.anthropic.com
