# =====================================================================
# Spartan — Ethereum DeFi MVP: minimal environment
# Copy to `.env` and fill in. `.env` is gitignored — never commit keys.
# This file covers ONLY what the Ethereum MVP needs. See README for the
# full Spartan variable set.
# =====================================================================

# ---------------------------------------------------------------------
# AI model (at least one required)
# ---------------------------------------------------------------------
ANTHROPIC_API_KEY=your_anthropic_api_key        # Claude (default model provider)
# OPENAI_API_KEY=your_openai_api_key             # GPT / embeddings (alternative)

# ---------------------------------------------------------------------
# Ethereum RPC — read by getRpcUrl() in
# src/plugins/multiwallet/utils/ethereum.ts
# Priority: ETHEREUM_RPC_URL > EVM_PROVIDER_URL > built-in default.
#
# For SAFE local testing, run an Anvil mainnet fork and point here:
#   anvil --fork-url https://eth.llamarpc.com
# then use the fork endpoint below (same mainnet addresses, free ETH).
# ---------------------------------------------------------------------
ETHEREUM_RPC_URL=http://127.0.0.1:8545
# EVM_PROVIDER_URL=http://127.0.0.1:8545         # alternative name (also accepted)

# For real mainnet instead of a fork, set a provider URL, e.g.:
# ETHEREUM_RPC_URL=https://eth.llamarpc.com
# ETHEREUM_RPC_URL=https://mainnet.infura.io/v3/<key>

# ---------------------------------------------------------------------
# Database
# Easiest for the MVP: leave these unset and let ElizaOS fall back to a
# local SQLite/PGlite store (~/.eliza/db). Set only if using a server.
# ---------------------------------------------------------------------
# POSTGRES_URL=postgresql://user:password@localhost:5432/spartan
# MYSQL_HOST=localhost
# MYSQL_PORT=3306
# MYSQL_USER=root
# MYSQL_PASSWORD=your_mysql_password
# MYSQL_DATABASE=spartan

# ---------------------------------------------------------------------
# Notes
# - Wallets are imported in-chat ("import wallet 0x<privkey>"); the MVP
#   does not read a private key from env for end-user wallets.
# - Use a THROWAWAY key for testing. On an Anvil fork you can use one of
#   the pre-funded dev keys printed when anvil starts.
# ---------------------------------------------------------------------
